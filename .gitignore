test-results/

# Local working output (reports, scratch files)
output/

# Real, consented scans and phone photos used to measure OCR accuracy (personal data: never committed)
sample-documents/real/

# rendered by npm run factory:render from test/factory/content (regenerable)
sample-documents/factory/

# pixel capture recordings and screenshots (local; e2e/visual.spec.ts)
e2e/visual-data/
e2e/browsers-results/
e2e/browsers-report/
.e2e-run/

# Load test results (load/run.sh): numbers from a run, kept on the Mac only
load/results/
