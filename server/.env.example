# Copy to server/.env (never commit it). The server loads it automatically.

# RoleMatch reads documents with its own built-in parser. There is no outside AI service and no AI key: by decision, any model used later must run on our own infrastructure.

# Concurrency: documents processed at once, and per organisation.
# WORKER_CONCURRENCY=4
# PER_ORG_CONCURRENCY=2

# Set true when served over HTTPS.
# COOKIE_SECURE=true

# Supabase. The secret key has full power: keep it server-side only, never in the frontend or in git.
# Project URL, like https://<project-ref>.supabase.co
SUPABASE_URL=
# Project Settings > API Keys > secret key
SUPABASE_SERVICE_ROLE_KEY=
# Connect > Session pooler connection string, with your database password filled in
DATABASE_URL=

# E-mail: templates are in server/src/email.ts; sending is in server/src/mail (see the MAIL_* settings below).
# Outgoing mail (RoleMatch owns the queue and policy; the only outside piece is an SMTP submission service). Real values go ONLY in server/.env (ignored by Git)
# or the host's secret store: never in source, settings, the browser or logs. Unset MAIL_TRANSPORT = mail is reported unavailable (invitations wait; nothing is "sent").
# MAIL_TRANSPORT=smtp                       # smtp | preview (development: writes files, sends nothing)
# MAIL_FROM=RoleMatch <info@rolematch.co.za>   # the approved sender identity (this is also the default)
# MAIL_SMTP_HOST=                           # a host name its TLS certificate covers (confirm with the mail host)
# MAIL_SMTP_PORT=465                        # 465 = implicit TLS, 587 = STARTTLS
# MAIL_SMTP_SECURITY=implicit               # implicit | starttls  (none is accepted only for a server on this computer)
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=                           # secret
# MAIL_BOUNCE_ADDRESS=                      # optional envelope sender (where bounces return)
# MAIL_MAX_PER_HOUR=60                      # keep at or below the host's real limit, in writing
# MAIL_RESERVED_AUTH_PER_HOUR=15            # headroom only verification messages may use
# MAIL_SEND_MODE=allowlist                  # off | allowlist (default) | live. Default deny: real mail goes ONLY to MAIL_ALLOWED_RECIPIENTS, for every kind of message
# MAIL_ALLOWED_RECIPIENTS=                  # comma list of approved test recipients (an empty list sends nothing)
# Do not edit the MAIL_* lines by hand: use `npm run mail:config -- status | credentials | allow | enable | disable` (it keeps the file private and never shows the password).
# PUBLIC_APP_URL=http://localhost:5173      # where invitation links point (https and real in production)
# How long a verification code stays valid (15 minutes).
# OTP_EXPIRY_MINUTES=15      # enforced by RoleMatch; also set the Supabase project OTP expiration to 900 seconds

# DEVELOPMENT ONLY: with no mail transport, write each sign-up email to server/data/emails/ as a preview file and print the code to the console.
# The server refuses to start with this on when COOKIE_SECURE=true (production).
# SIGNUP_DEV_CODE=true
# Set true only when the server sits behind a proxy you control (so X-Forwarded-For can be believed).
# TRUST_PROXY=false
# Apply new database migrations at startup (default true in development, false in production).
# AUTO_MIGRATE=true

# TEST MODE: set false to sign up without an emailed code (the account is created confirmed and signed in at once).
# The server refuses to start with this when COOKIE_SECURE=true. Leave unset (codes required) for anything public.
# SIGNUP_REQUIRE_CODE=false

# Optional: a read-only copy of the database (docs/architecture/RESILIENCE.md, step 3). When the main database is unreachable, RoleMatch reads
# from here, shows "saving is paused", and switches back by itself. Leave empty to run without one.
READ_FALLBACK_DATABASE_URL=
# For the local copy kept by `npm run copy:watch` (needs Colima), use the address given in server/README.md.
# How often copy:watch refreshes it, in minutes.
COPY_REFRESH_MINUTES=5
# How often the main database is checked, in milliseconds (two failures switch to the copy, two successes switch back).
DB_CHECK_MS=5000

# Optional: encrypts what RoleMatch keeps on its own server for outages (docs/architecture/RESILIENCE.md): uploads held while saving is paused,
# the copy of original CVs, and audit entries journaled until the audit log can be written.
# 32 random bytes, base64: generate with `openssl rand -base64 32`. Keep it secret and out of the repository. Empty: none of these are kept, and uploads or original views during an outage are refused instead.
LOCAL_ENCRYPTION_KEY=

# The monitor's service token for /api/ops/health (docs/ops/MONITORING.md). At least 32 characters: openssl rand -hex 32. Empty: the endpoint does not exist.
OPS_TOKEN=
