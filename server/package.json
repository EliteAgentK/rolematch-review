{
  "name": "rolematch-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "start": "node --import tsx src/index.ts",
    "worker": "node --import tsx src/worker.ts",
    "test": "vitest run",
    "create-user": "node --import tsx src/scripts/createUser.ts",
    "migrate": "node --import tsx src/scripts/migrate.ts",
    "eval:panels": "node --import tsx test/messy/variants.ts original",
    "golden:update": "node --import tsx test/golden/update.ts",
    "stress:headings": "node --import tsx test/stress/headings.ts",
    "stress:show": "node --import tsx test/stress/show.ts",
    "stress": "node --import tsx test/stress/run.ts",
    "eval:variants": "node --import tsx test/messy/variants.ts",
    "eval:ocr": "node --import tsx test/ocr/eval.ts",
    "eval:parser": "node --import tsx test/messy/eval.ts --failures",
    "build:messy": "node --import tsx test/messy/build.ts --force",
    "build:samples": "node --import tsx test/sample/build.ts",
    "build:scanned": "node --import tsx test/sample/buildScanned.ts",
    "build:long": "node --import tsx test/sample/buildLong.ts",
    "build:heavy": "node --import tsx test/sample/buildHeavy.ts",
    "build:photos": "node --import tsx test/sample/buildPhotos.ts",
    "audit:check": "node scripts/auditCheck.mjs",
    "schema:check": "node --import tsx src/scripts/schemaCheck.ts",
    "typecheck": "tsc --noEmit",
    "sample:parse-cvs": "node --import tsx test/sample/parseCvs.ts",
    "sample:dry-run": "node --import tsx test/sample/dryRun.ts",
    "sample:mine": "node --import tsx test/sample/mine.ts",
    "stress:items": "node --import tsx test/stress/items.ts",
    "stress:rotate": "node --import tsx test/stress/rotate.ts",
    "stress:quality": "node --import tsx test/stress/quality.ts",
    "docs:points": "node --import tsx scripts/pointsDoc.ts",
    "build:extensive": "node --import tsx test/extensive/build.ts",
    "test:local": "node --import tsx scripts/testLocal.ts",
    "rehearse:outage": "node --import tsx scripts/rehearseOutage.ts",
    "copy:refresh": "node --import tsx scripts/refreshCopy.ts",
    "copy:watch": "node --import tsx scripts/refreshCopy.ts --watch",
    "visual:baseline": "node --import tsx scripts/visualCheck.ts",
    "visual:compare": "node --import tsx scripts/visualCheck.ts --compare",
    "golden:photos": "node --import tsx test/golden/photos.ts",
    "eval:pack300": "node --import tsx test/pack300/eval.ts",
    "deps:report": "node --import tsx scripts/depsReport.ts",
    "mail:config": "tsx scripts/mailConfig.ts",
    "mail:trial": "tsx scripts/mailTrial.ts",
    "parser:gate": "node --import tsx test/failures/gateCli.ts",
    "register:report": "node --import tsx test/failures/registerReport.ts",
    "eval:headings": "node --import tsx test/candidate/headingInvariance.ts",
    "eval:matching": "node --import tsx test/candidate/matchingEval.ts",
    "eval:judgements": "node --import tsx test/candidate/matchingExplain.ts",
    "eval:fields": "node --import tsx test/candidate/fields.ts",
    "eval:real:candidate": "node --import tsx test/real/candidateReal.ts",
    "acceptance": "node --import tsx test/real/acceptanceRun.ts",
    "eval:real": "node --import tsx test/real/realCvs.ts",
    "eval:proto": "node --import tsx test/proto/compare.ts",
    "eval:real:proto": "node --import tsx test/real/protoReal.ts",
    "review:real": "node --import tsx test/real/reviewServer.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@napi-rs/canvas": "^1.0.13",
    "@tesseract.js-data/afr": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@xmldom/xmldom": "0.8.15",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.9.1",
    "utif2": "^4.1.0",
    "word-extractor": "1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@gutenye/ocr-node": "^1.4.9",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "docx": "^9.15.0",
    "esbuild": "0.28.2",
    "onnxruntime-common": "^1.30.0",
    "onnxruntime-node": "^1.30.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "onnxruntime-node": false,
    "protobufjs": false,
    "tesseract.js": false
  }
}
