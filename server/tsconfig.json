{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2023"], "types": ["node"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "allowImportingTsExtensions": true, "resolveJsonModule": true, "isolatedModules": true,
    "noUnusedLocals": true
  },
  "include": ["src"]
}
