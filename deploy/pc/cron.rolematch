# RoleMatch on the PC (times are South African). Installed as /etc/cron.d/rolematch.
# Owner, 6 Nov 2026: nightly backups kept 14 days; a daily check of everything, mailed every day.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
30 1 * * * root /srv/rolematch/deploy/pc/backup-nightly.sh >> /var/log/rolematch-backup.log 2>&1
0 6 * * * root /srv/rolematch/deploy/pc/daily-check.sh >> /var/log/rolematch-daily-check.log 2>&1
# Our own database (rm-db, ADR-004 phase 2): a full backup each Sunday, a differential every other night, the change log continuously,
# and a restore drill each Monday whose result the daily check reports.
15 2 * * 0 root docker exec -u postgres rm-db pgbackrest-keyed --stanza=rolematch --type=full backup >> /var/log/rolematch-db-backup.log 2>&1
15 2 * * 1-6 root docker exec -u postgres rm-db pgbackrest-keyed --stanza=rolematch --type=diff backup >> /var/log/rolematch-db-backup.log 2>&1
45 3 * * 1 root /srv/rolematch/db-src/db/drill.sh rm-db > /srv/rolematch/backups/.db-drill-last 2>&1
# What the owner's console shows from the PC itself (docs/database/18_CONSOLE_V0.md): every minute.
* * * * * root /srv/rolematch/deploy/pc/host-status.sh >> /var/log/rolematch-host-status.log 2>&1
# Linux's heartbeat for the Windows watchdog (deploy/dell/watchdog.ps1, incident 10 Nov 2026): the watchdog restarts WSL only when this is stale AND the API is down.
* * * * * root [ -d /mnt/c/ProgramData/RoleMatch/linux ] && date +\%s > /mnt/c/ProgramData/RoleMatch/linux/heartbeat
# The PC's own database and sign-in pair (docs/architecture/DESIGN_JOHANNESBURG_MOVE.md): a base copy each night after live's backup, kept 14 days with its
# WAL (archived every 60 s), and the restore drill each Monday. Only where the pair exists; each writes one line to its log.
45 1 * * * root [ -f /etc/rolematch/next/stack.env ] && bash /srv/rolematch/deploy/db/stack/backup.sh /etc/rolematch/next/stack.env /srv/rolematch/next/backups >> /var/log/rolematch-next-backup.log 2>&1
0 4 * * 1 root [ -f /etc/rolematch/next/stack.env ] && bash /srv/rolematch/deploy/db/stack/drill.sh /etc/rolematch/next/stack.env /srv/rolematch/next/backups >> /var/log/rolematch-next-drill.log 2>&1
