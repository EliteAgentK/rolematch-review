# Copy to /etc/rolematch/live.env on the server (chmod 600, owner root). Never commit the real file. deploy/makeLiveEnv.sh fills what it can without printing anything.

# Addresses
PUBLIC_APP_URL=https://app.rolematch.co.za
# Behind the Cloudflare tunnel every visitor reaches the server over the tunnel's connection, and Cloudflare only ADDS to x-forwarded-for, whose first
# value the visitor chooses: the visitor's address must come from the header Cloudflare overwrites, or the per-address limits on passwords and codes
# count whatever address an attacker sends (server/src/visitor.ts; independent security review, 23 Nov 2026). Leave it empty only behind Caddy.
CLIENT_IP_HEADER=cf-connecting-ip
ALLOWED_ORIGINS=https://app.rolematch.co.za

# Supabase: the live project, separate from development. The session-mode address (port 5432) only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Who may start a new organisation. invite: an invitation or an address on the list below. open is the product's public registration, set after the activation report.
SIGNUP_MODE=invite
SIGNUP_ALLOWED_EMAILS=
SIGNUP_REQUIRE_CODE=true

# E-mail: real delivery. allowlist until the checks pass and the owner enables live (activation report); then MAIL_SEND_MODE=live.
MAIL_TRANSPORT=smtp
MAIL_SEND_MODE=allowlist
MAIL_ALLOWED_RECIPIENTS=
MAIL_FROM=RoleMatch <info@rolematch.co.za>
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURITY=implicit
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
# Keep at or below what the mail host allows, in writing (docs/ops/MAIL_SETUP.md).
MAIL_MAX_PER_HOUR=60
MAIL_RESERVED_AUTH_PER_HOUR=15

# 32 random bytes, base64
LOCAL_ENCRYPTION_KEY=
# At least 32 characters
OPS_TOKEN=
# Encrypts the nightly backup (deploy/backup.sh). Keep a copy off the server: without it a backup cannot be read.
BACKUP_KEY=

# Reading CVs: the candidate pipeline for everyone. It passed its criteria on unseen Word and PDF, and failed on scans (docs/parser/RESULTS_2026-11-04.md), so every scan goes to a person until they pass (register R95, temporary).
CANDIDATE_PIPELINE=all
REVIEW_ALL_SCANS=true

# Claude (server/src/aiRead.ts, aiMatch.ts): Haiku reads every CV with the parser, Sonnet checks every match. The key is NOT here: it is in /etc/rolematch/ai.env,
# given to the AI worker alone (deploy/mac/run.sh). Off, or with no key, the parser and the rules work alone.
AI_READING=on
AI_MATCHING=on
# The platform's monthly safety cap in US dollars, across every organisation; each portal's own use is metered in ai_usage for its bill.
AI_MONTHLY_CAP_USD=25

# Trends (docs/ops/TRENDS_AND_LOAD.md): where the monitor asks Prometheus for firing trend alerts. Empty where Prometheus does not run.
PROMETHEUS_URL=http://127.0.0.1:9090
